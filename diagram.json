{
  "version": 1,
  "author": "ESP32-S3-TOOLS-PRO-V1",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": -10,
      "left": -10,
      "attrs": { "env": "esp32s3dev" }
    },
    {
      "type": "wokwi-ili9341",
      "id": "display",
      "top": -110,
      "left": 310,
      "attrs": { "rotation": "90" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnUp",
      "top": 270,
      "left": 320,
      "attrs": { "color": "green", "label": "UP" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnOk",
      "top": 270,
      "left": 410,
      "attrs": { "color": "blue", "label": "OK" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnDown",
      "top": 270,
      "left": 500,
      "attrs": { "color": "red", "label": "DOWN" }
    }
  ],
  "connections": [
    [ "esp:3V3", "display:VCC", "red", [ "h40" ] ],
    [ "esp:GND.1", "display:GND", "black", [ "h20" ] ],
    [ "esp:GPIO12", "display:CLK", "green", [ "h80" ] ],
    [ "esp:GPIO11", "display:MOSI", "green", [ "h100" ] ],
    [ "esp:GPIO13", "display:MISO", "green", [ "h120" ] ],
    [ "esp:GPIO10", "display:CS", "green", [ "h140" ] ],
    [ "esp:GPIO9", "display:DC", "green", [ "h160" ] ],
    [ "esp:GPIO8", "display:RESET", "green", [ "h180" ] ],
    [ "esp:GPIO3", "display:LED", "orange", [ "h200" ] ],
    [ "esp:GPIO1", "btnUp:1.l", "green", [ "h30", "v230" ] ],
    [ "esp:GPIO2", "btnOk:1.l", "green", [ "h50", "v210" ] ],
    [ "esp:GPIO21", "btnDown:1.l", "green", [ "h70", "v190" ] ],
    [ "esp:GND.2", "btnUp:2.r", "black", [ "h-20", "v-20" ] ],
    [ "esp:GND.2", "btnOk:2.r", "black", [ "h-40", "v-40" ] ],
    [ "esp:GND.2", "btnDown:2.r", "black", [ "h-60", "v-60" ] ]
  ]
}
